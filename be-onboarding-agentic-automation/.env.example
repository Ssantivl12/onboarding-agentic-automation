# LLM_PROVIDER options:
# - openai: OpenAI Responses API
# - claude or anthropic: Anthropic Messages API
# - openai-compatible: providers exposing /v1/chat/completions
# - fake: local testing without API key
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-nano

# Generic key used by any real provider when provider-specific keys are empty.
LLM_API_KEY=

# Optional provider-specific keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional for OpenAI-compatible providers, e.g. https://api.example.com/v1
LLM_BASE_URL=

# Postgres + pgvector store for documents, chunks and retrieval.
# Example: postgresql+psycopg://postgres:postgres@localhost:5432/onboarding_agent
DATABASE_URL=

# RAG embeddings.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RAG_TOP_K=5
RAG_CANDIDATES=20
RAG_MIN_VECTOR_SCORE=0.2
RAG_ENABLE_ANSWERABILITY=true

# Knowledge-base storage. Uploaded PDFs go to KB_UPLOAD_DIR and converted
# Markdown goes to KB_DIR; chunks and embeddings are persisted in Postgres.
KB_DIR=kb
KB_UPLOAD_DIR=kb/_uploads
KB_MAX_UPLOAD_MB=10
